# Numpy Data types
# 1. intigers i.e. int8, int16, int32,int64, int128 
# important we do "downcasting" that we can make memory efficient like we have age max 200 or 300 so we can make suitable data type so that we can save memory that take extra 
# space not required for that or more than enough so we can make it efficient
arr = np.array([1,3,4,5,6])
print(arr, arr.dtype)

# 2. floating data type: float32, float64
arr = np.array([1,3,4,5,6,5.6])
print(arr, arr.dtype)

# 3. The boolean data type in NumPy stores binary values as either True or False
scores = np.array([45, 88, 92, 31, 75])
is_passing = scores >= 50
print("Boolean Array:", is_passing)
print("Data Type:", is_passing.dtype)
# 3. Use the boolean array to filter out the raw data
passed_scores = scores[is_passing]
print("Filtered Array:", passed_scores)

# 4. we have complex number like 2 + 3i here 2 is real part and 3i is imaginary part : like complex64, complex128
# important point if we have 64bsts number array will take 128 because complex numbers have two parts like 64 + 64 = 128
arr1 = np.array([3 + 5j])
arr2 = np.array([2 + 3j])
print(arr1 + arr2)
print(arr1 - arr2)
print(arr1.dtype)

# 5. string but we don't use string alot in numpy as we do numerical calculation: i.e. S(bute-str) & U(unicode-str)
arr = np.array([1,3,4,5,6, "helo"])
print(arr, arr.dtype)

# 6. Objects also same like string we don't use objects a lot 
arr = np.array(["prime", {1,2,3},3.14])
print(arr, arr.dtype)


