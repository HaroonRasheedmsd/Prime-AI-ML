import numpy as np
import time


# compare executeion time of python list and numpy array
size = 1_000_000

# for python list
py_list = list(range(size))
start = time.time()
sq_list = [x**2 for x in py_list]
end = time.time()
print(f"Python list time: {end - start} seconds")

# for numpy array
np_array = np.array(py_list)
start = time.time()
sq = np_array ** 2
end = time.time()
print(f"NumPy array time: {end - start} seconds")


# to compare in memory consumption by Python list and numpy array
import sys 
# for Python list
# print(f"Python list size: {sys.getsizeof(py_list) * len(py_list)} bytes") 
# the above line has flowed becuase it just multiplied the size of the outer boxgnores the actual weight of the data items

# here is the correct operation: To get the true size, you must weigh the container box plus every individual object it points to.
total_size = sys.getsizeof(py_list) + sum(sys.getsizeof(item) for item in py_list)
print(f"Python list size: {total_size} bytes")

# for Numpy array
print(f"Numpy array size: {np_array.nbytes} bytes")


# Create array from Lists 
