# Vector Normalization: Normalization an array means transforming its values so they fit into a specific scale or range
# normalize 
arr = np.array([[1,2],[3,4]])
mean = np.mean(arr)
std_dev = np.std(arr)
normalized_arr = (arr - mean) / std_dev
print(normalized_arr)
print(mean)
print(std_dev)


# Important methematical functions 

# 1. Aggregation: in this we get some single output
arr = np.array([1,2,3,4,5])
print(np.sum(arr)) # sum ()
print(np.prod(arr)) # prod() called product
print(np.min(arr)) # min() gives minimum value
print(np.max(arr)) # max() gives maximum value
print(np.argmin(arr)) # argmin() gives index of minimum value
print(np.argmax(arr)) # argmax() gives index of maximum value
print(np.mean(arr)) # mean() gives mean
print(np.std(arr)) # std() gives standared deviation value x=[1,2,3,4] and formulas is variance = under-root(sumation( x1 - mean)square / N) so here x1 is like index 0,1,2,3... for all values separately
print(np.median(arr)) #median() gives midle valud of sorted arrays
print(np.var(arr)) # var() gives the value like we have x=[1,2,3,4] and formulas is variance = sumation( x1 - mean)square / N . 


# power function : calculate power of something
arr = np.array([1,2,3,4,5])
print(np.square(arr)) # calculate square of values
print(np.sqrt(arr)) # calculate square root for values
print(np.pow(arr, 3)) # calculate power to the value for each values



# Log and exponential  related fucntion
arr = np.array([1,2,3,4,5])
print(np.log(arr)) # calculate natural log for each values natural log is basically base to e (exponential)
print(np.log10(arr)) # calculate log values like log10 , log2
print(np.exp(arr))



