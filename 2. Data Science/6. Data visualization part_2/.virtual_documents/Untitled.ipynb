import numpy as np
import matplotlib.pyplot as plt

# Histogram : histogram shows distribution of numerical data.
# dividing values into bins(range).
# counting how many values fall into each bin(frequency)

np.random.seed(0)
bins = [0, 30, 70, 90, 100]
scores = np.random.normal(70, 10, 100) # normal distribution
plt.hist(scores, color="skyblue", edgecolor="black", bins=bins)
plt.ylabel("# of students")
plt.xlabel("scores")


# Multiple datasets
# Legitimate Transactions: Small, predictable everyday amounts
legit_transactions = [
    45.20, 52.10, 38.50, 61.30, 49.90, 
    55.00, 32.40, 48.15, 66.80, 50.05,99.9, 100, 9
]

# Fraudulent Transactions: Unusually high, erratic amounts
fraud_transactions = [
    320.00, 450.50, 280.10, 510.00, 395.40, 
    120.00, 600.00, 299.99, 410.20, 350.00
]

plt.hist(legit_transactions, color = "green", bins=10, edgecolor="black", alpha=0.5, label = "legit")
plt.hist(fraud_transactions, color = "red",bins=10, edgecolor="black", alpha=0.5, label = "fraud")
plt.legend()
plt.xlabel("amount (in $)")
plt.ylabel("Number of transactions")


# axvline: draw a vertical reference line on a plot, commone to:
# mark cutoffs, averages, pass marks, or thresholds, means:
# to signify any particular value may be mean, or any other
np.random.seed(0)
bins = [0, 30, 70, 90, 100]
scores = np.random.normal(70, 10, 100) # normal distribution
plt.hist(scores, color="skyblue", edgecolor="black", bins=bins)
plt.ylabel("# of students")
plt.xlabel("scores")
plt.axvline(
    x=33,
    label="Passing marks (33)",
    color="red",
    linewidth="2",
    linestyle="--"
)
plt.legend()


# Box plot
data = [7, 8, 5, 6, 9, 4, 10, 12, 15] # 

plt.boxplot(data)
plt.grid(True)


# Multiple Datasets in Boxplot
group1 = np.random.normal(50, 10, 100)
group2 = np.random.normal(60, 15, 100)

plt.boxplot([group1, group2], tick_labels=["goup1", "group2"], showmeans = True)
#plt.boxplot([group1, group2], tick_labels=["goup1", "group2"], vert=False) # for horizental boxplot
plt.grid(True)
plt.show()

