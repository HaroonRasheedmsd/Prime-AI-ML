# Transformin Data (Feeture Engineering) : to create new columns, to create some new features that can improve the performance of the models

# Methods to Transform Data
# e.g: we need "tax" column based on salary like:
import pandas as pd
df = pd.read_csv("employee_data.csv")
df1 = df.copy()

# 1. aplly()
df1["tax"] = df1["Salary"].apply(lambda x : "20%" if x >=60000 else "10%") # apply() function is used and it is higher order function as we passed another function as a parameter
df1

# 2. map() : to map existing values with new values: like Male => M, Female=> F, etc using dictionary
department_map = {"Finance" : "F", "Marketing" : "M", "HR" : "HR", "IT" : "IT"}
df1["Department"] = df1["Department"].map(department_map)
df1

# 3. assing(): we create new column by assigning them some values like: Salary increase by 10% 
df1 = df1.assign(new_income = df1["Salary"] * 1.1)
df1

# 4. replace(oldval, newval) : we can replace specific old values with new values like: lets replace David with J.David
df1["Name"] = df1["Name"].replace("David", "J.David")
df1

# 5. rename(columns = {old:new}) : we can rename our old columns or rows with new one
df1 = df1.rename(columns = {"Salary" : "Income"})
df1 = df1.rename(index = {1:"first"})
df1

# 6. sort_values() : sort data on the basis of values
df1 = df1.sort_values("Income") # this is done in ascending order for descending order just do: sort_values("Income", ascending = False)
df1 = df1.sort_values(["Income", "Age"]) # here sorting is done using income but if two incomes equal each other then according to age sorting is done
df1

# 7. sort_index(): to sort data according to index 
df1 = df1.rename(index={"first":1})
df1
df1.sort_index()

# 8. reset_index(): to preserve the original index 
df1.reset_index()
df1.reset_index(drop = True) # here if don't want to preserve then we use drop 

# 9. rank() : to rank data: like to assign rank from lowest to highest data
df1["Ranking"] = df1["Income"].rank() # to change ranking order pass: ascending = False, then order will change if 1 highest then it will be lowest
# here if values have same data upon which we do ranking then the average is taken and assign that also if you iqnore fraction: pass, method="dense". also at place we use min & max to solve ties
df1 

# 10. To reordered columns e.g:
df1[["ID", "Name", "Department", "Age", "Income", "new_income", "tax", "Ranking"]]


# Practice problem: to re-order and shift id to end
df2 = df1.copy()
new_col_order = [col for col in df2.columns if col != "ID"] + ["ID"]
df2[new_col_order]


# Writeing data to csv and json file
df3 = df2.copy()
df3 = df3.drop_duplicates()
df3 = df3.sort_values("Income")
df3 = df2.reset_index(drop = True)

# write to csv file
df3.to_csv("sorted_data.csv")


df3


# Grouping & Aggregation of Data: here we group things and then we apply aggregation methods like:
# we want to group data using departments name and then calculate the mean of income for each department
df3.groupby("Department")["Income"].mean()

# calculate minimume income 
df3.groupby("Department")["Income"].min()
df3.groupby("Department")["Income"].max()

# if we want to calculate for name
df3.groupby("Name")["Income"].max()

# for multiple calculation at once 
df3.groupby("Department")["Income"].agg(["max", "min", "mean"])
df3.groupby("Department")["Income"].aggregate(["max", "min", "mean"]) # same as agg()

# To rename the column names
df3.groupby("Department")["Income"].agg(max_income = "max", min_income = "min", mean_income = "mean")

# to apply same operation at once on multiple parameters
df3.groupby("Department").agg({
    "Income" : "mean",
    "Age" : "mean"
})

# to apply multiple operations at once on multiple parameters
df3.groupby("Department").agg({
    "Income" : "mean",
    "Age" : "max"
})

# also to renmae
df3.groupby("Department").agg(
    meam_Salary = ("Income" , "mean"),
    max_Age = ("Age" , "max")
)


# Melt & Pivot: two important keywords
# 1. Melt: Wide to Long format. function is: melt(id_vars, value_vars, var_name, value_name), i. id_vars: columns to keep. ii. value_vars: these are values which we melt into single column
# 3. var_name: Named the column in which we combined or melt multiple columns, iv. value_name: here name the column in which values are stored
# e.g:
df4 = pd.DataFrame({
    "country" : ["USA", "USA", "India", "India"],
    "year" : [2020, 2021, 2020,2021]
    "sales" : [100, 120, 90, 110],
    "profit" : [20, 25, 18, 22]
})

df4.melt(
    id_vars = ["country", "year"],
    value_vars = ["sales", "profit"],
    var_name = "metrics",
    value_name = "value"
)



