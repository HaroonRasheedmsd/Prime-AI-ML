# Plot Methods 
# 1. plt.plot(x,y)  # - line plot
# 2. plt.bar(x, height) # - Vertical bar chart
# 3. plt.barh(x, width) # - Horizental bar chat
# 4. plt.scatter(x,y) # - Scatter plot
# 5. plt.pie(data) # - Pie chart
# 6. plt.hist(data, bins) # - Histogram
# 7. plt.boxplot(data) # - box plot


# 2. bar(): a bar plot (or bar chart) is a graph that displays categorical data using rectangular bars. 
# each bar's height (or length, in horizental bars ) represents a value.
movies = [
    "The Dark Knight",
    "The Hurt Locker",
    "The King's Speech",
    "The Artist",
    "Argo"
]

years = [2008, 2009, 2010, 2011, 2012]
oscar_revenue = [1005, 170, 427, 133, 232] # in $M
plt.bar(years, oscar_revenue, color = "grey")
plt.title("Revenue in each Year for Oscar movies")
plt.xlabel("Years")
plt.ylabel("Revenue (in $M)")

# plt.text() # it is used print label or values means print details and sepecifications
# like: text(x-axis position, y-axis position, text, alignment) 
for i in range(len(years)):
    plt.text(years[i], oscar_revenue[i] + 10, str(oscar_revenue[i]), ha = "center")

# extend graph limits(area) using xlim(), and ylim()
plt.ylim(0, max(oscar_revenue) + 100)
#plt.xlim(min(years), max(years) + 1)



# Compare 2 sets of Data
# We customise width. Width controls how thick each bar is. Usually ranges from 0 to 1. [Default val is 0.8]
import numpy as np
oscar_movies = [
    "The Dark Knight",
    "The Hurt Locker",
    "The King's Speech",
    "The Artist",
    "Argo"
]

oscar_revenue = [1005, 170, 427, 133, 232] # in $M

non_oscar_movies = ["Slumdog Millionaire", "Avatar", "Inception", "Hugo", "Lincoln"]
non_oscar_revenue = [378, 2788, 829, 185, 275] # in $M
years = [2008, 2009, 2010, 2011, 2012]

x = np.arange(len(years))
width = 0.35  
plt.bar(x - width/2, oscar_revenue, width, label = "Oscar Movies") # shifting to left
plt.bar(x + width/2, non_oscar_revenue, width, label = "Non-Oscar Movies") # shifting to right

