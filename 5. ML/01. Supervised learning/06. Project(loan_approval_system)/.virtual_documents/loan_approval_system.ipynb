


# Import libraries 
import numpy as np
import pandas as pd
import seaborn as sns
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split


# Read Data
df = pd.read_csv("loan_approval_data.csv")
df.head()


# lets get some information about data
df.info()
df.isnull().sum() # to find null values in each column
df.describe()





# We have two types of columns categorical(fill missing values with mode of entire col) and 
# numerical(fill missing values with mean of entire col) 

# so first we have to separate both kind of columns based on categorical and numerical

categorical_cols = df.select_dtypes(include = ["object", "str"]).columns
numerical_cols = df.select_dtypes(include = ["number"]).columns # we use "number", despite using "float64", "int64" 


categorical_cols
numerical_cols

# To check is completely and safely seperated
categorical_cols.size + numerical_cols.size


# so now we both fill separately using sklearn imputer (a simple way for this problem)
# "sklean imputer": used to complete missing values with simple strategies so will
# use our strategy that we pass our column and tell to fill with mean, median, mode or constant value

from sklearn.impute import SimpleImputer

# for numerical null values
num_imp = SimpleImputer(strategy = "mean")
df[numerical_cols] = num_imp.fit_transform(df[numerical_cols])



df.head()


# for categorical null values
categ_imp = SimpleImputer(strategy = "most_frequent")
df[categorical_cols] = categ_imp.fit_transform(df[categorical_cols])


df.head()
df.isnull().sum()





# first we check how Balanced our classes are?
classes_count = df["Loan_Approved"].value_counts()

plt.pie(classes_count, labels=["No", "Yes"], autopct="%1.1f%%")
plt.title("Is Loan approved or not?")


