# Plot for y = √x

import numpy as np
import matplotlib.pyplot as plt

# Define x values (x >= 0 for sqrt)
x = np.linspace(0, 100, 100_000)
y = np.sqrt(x)

# Plot
plt.plot(x, y, label = "y = √x")
plt.xlabel("X")
plt.ylabel("Y")
plt.title("y = √x")
plt.legend()
plt.grid(True)

plt.show()


